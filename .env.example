# ---------------------------------------------------------------------
# The three variables a deployment actually needs.
# ---------------------------------------------------------------------

# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable (anon) key. Public by design: it ships in the browser
# bundle, and Row Level Security — not this key — is what protects the
# data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The switch. "seed" runs the in-memory reference book with no database
# and no auth; "supabase" is the real thing. The default is seed on
# purpose — a missing variable should start a working demo, not a
# production instance that appears to accept uploads and loses every one.
DATA_PROVIDER=seed

# ---------------------------------------------------------------------
# NOT needed by the application.
# ---------------------------------------------------------------------

# Used only by `npm run verify:live`, which checks a real project's schema
# past RLS. It bypasses every policy in the database, so it belongs in a
# local shell for that one command and nowhere else — not in a deployment's
# environment, and never in a NEXT_PUBLIC_ name.
#
#   NEXT_PUBLIC_SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=... npm run verify:live

# Show the "Sign in with Microsoft" button. Leave unset until the Azure
# provider is actually enabled in Supabase Auth: signInWithOAuth navigates
# the browser away before it can report an unconfigured provider, so the
# button would land a person on a raw JSON error page with nothing the
# application can do about it.
#
#   NEXT_PUBLIC_MICROSOFT_SIGNIN=on

# ---------------------------------------------------------------------
# The daily digest does NOT read anything from here.
# ---------------------------------------------------------------------
#
# It runs as a Supabase Edge Function, not as part of this deployment,
# precisely so the web app never needs the service-role key. Its
# settings — RESEND_API_KEY, DIGEST_SECRET, APP_URL, DIGEST_FROM — live
# in Supabase Dashboard → Edge Functions → Secrets. See DEPLOY.md.
#
# If you find yourself wanting to add an email key here, the digest has
# probably been moved into the app, and the reasoning in DEPLOY.md about
# where the service-role key may live needs revisiting first.
