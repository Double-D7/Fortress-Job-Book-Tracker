# ---------------------------------------------------------------------
# The three variables a deployment actually needs.
# ---------------------------------------------------------------------

# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable (anon) key. Public by design: it ships in the browser
# bundle, and Row Level Security — not this key — is what protects the
# data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The switch. "seed" runs the in-memory reference book with no database
# and no auth; "supabase" is the real thing. The default is seed on
# purpose — a missing variable should start a working demo, not a
# production instance that appears to accept uploads and loses every one.
DATA_PROVIDER=seed

# ---------------------------------------------------------------------
# NOT needed by the application.
# ---------------------------------------------------------------------

# Used only by `npm run verify:live`, which checks a real project's schema
# past RLS. It bypasses every policy in the database, so it belongs in a
# local shell for that one command and nowhere else — not in a deployment's
# environment, and never in a NEXT_PUBLIC_ name.
#
#   NEXT_PUBLIC_SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=... npm run verify:live
