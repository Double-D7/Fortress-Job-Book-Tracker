# Supabase — required for the persistent (Postgres) data provider.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Data provider: "seed" (in-memory DP452 reference book) or "supabase".
DATA_PROVIDER=seed

# Microsoft Entra ID SSO for Fortress staff (configured in Supabase Auth).
NEXT_PUBLIC_SSO_PROVIDER=azure
